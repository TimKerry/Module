#!name=苹果 APNs 推送（可编辑策略版）
#!desc=修改下面的 argument 即可切换策略，设置后建议重连网络或开关飞行模式
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/Apple_Arcade.png
#!arguments=Proxy:DIRECT

[Rule]
DOMAIN-SUFFIX,push.apple.com,{{{Proxy}}}
DOMAIN-SUFFIX,akadns.net,{{{Proxy}}}
DOMAIN-KEYWORD,apple.com.edgekey.net,{{{Proxy}}}

